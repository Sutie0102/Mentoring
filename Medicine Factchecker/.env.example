# ── MedFact AI 환경 변수 ─────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 Git에 올라가지 않습니다)
# 모든 키는 서버에서만 사용되며 브라우저로 전송되지 않습니다.

# [권장] Claude API 키 — 없으면 '데모(규칙 기반) 모드'로 동작합니다.
ANTHROPIC_API_KEY=
# 사용할 모델 (기본값: claude-opus-5-5)
AI_MODEL=claude-opus-5-5

# [선택] NCBI(PubMed) API 키 — 없어도 동작하지만 초당 요청 한도가 3회 → 10회로 늘어납니다.
NCBI_API_KEY=
# [선택] NCBI 권장 연락처(도구 식별용). 비워두면 전송하지 않습니다.
NCBI_EMAIL=

# [선택] 영상 음성 전사(Whisper)용 OpenAI API 키 — 없으면 영상은 화면 문구(OCR)만 분석합니다.
OPENAI_API_KEY=

# [선택] 분당 분석 요청 한도 (IP 기준, 기본 8)
RATE_LIMIT_PER_MINUTE=8
